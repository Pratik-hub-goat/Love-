/* =================================
   START EXPERIENCE
================================= */

function startExperience() {

  const hero = document.querySelector(".hero");
  const message = document.getElementById("messageSection");

  hero.style.display = "none";

  message.classList.remove("hidden");

  message.scrollIntoView({
    behavior: "smooth"
  });

}


/* =================================
   SHOW PROPOSAL
================================= */

function showProposal() {

  const message = document.getElementById("messageSection");
  const proposal = document.getElementById("proposalSection");

  message.style.display = "none";

  proposal.classList.remove("hidden");

  proposal.scrollIntoView({
    behavior: "smooth"
  });

}


/* =================================
   YES BUTTON
================================= */

function sayYes() {

  const proposal = document.getElementById("proposalSection");
  const final = document.getElementById("finalSection");

  proposal.style.display = "none";

  final.classList.remove("hidden");

  final.scrollIntoView({
    behavior: "smooth"
  });

  createCelebration();

}


/* =================================
   THINK BUTTON
================================= */

function showThinking() {

  const button = document.querySelector(".think-btn");

  button.innerHTML = "Take your time ❤️";

  button.style.transform = "scale(1.05)";

  setTimeout(() => {

    button.innerHTML = "I'll be waiting 😌";

  }, 1800);

}


/* =================================
   FLOATING HEARTS
================================= */

function createHeart() {

  const container = document.querySelector(".hearts");

  const heart = document.createElement("div");

  heart.classList.add("floating-heart");

  heart.innerHTML = "♥";

  heart.style.left =
    Math.random() * 100 + "%";

  heart.style.fontSize =
    (12 + Math.random() * 25) + "px";

  heart.style.animationDuration =
    (5 + Math.random() * 7) + "s";

  heart.style.opacity =
    0.3 + Math.random() * 0.6;

  container.appendChild(heart);

  setTimeout(() => {

    heart.remove();

  }, 12000);

}


/* Create hearts continuously */

setInterval(createHeart, 500);


/* =================================
   SPARKLES
================================= */

function createSparkle() {

  const container =
    document.querySelector(".sparkles");

  const sparkle =
    document.createElement("div");

  sparkle.classList.add("sparkle");

  sparkle.style.left =
    Math.random() * 100 + "%";

  sparkle.style.top =
    Math.random() * 100 + "%";

  sparkle.style.animationDelay =
    Math.random() * 2 + "s";

  container.appendChild(sparkle);

}

for (let i = 0; i < 80; i++) {

  createSparkle();

}


/* =================================
   CELEBRATION
================================= */

function createCelebration() {

  for (let i = 0; i < 40; i++) {

    setTimeout(() => {

      createHeart();

    }, i * 80);

  }

}


/* =================================
   OPTIONAL MUSIC
================================= */

const music =
  document.getElementById("music");

const musicButton =
  document.getElementById("musicButton");

let musicPlaying = false;

function toggleMusic() {

  if (!music.src) {

    alert(
      "Add your own music file to the audio tag in index.html ❤️"
    );

    return;

  }

  if (musicPlaying) {

    music.pause();

    musicButton.innerHTML = "♫";

  } else {

    music.play();

    musicButton.innerHTML = "❚❚";

  }

  musicPlaying = !musicPlaying;

}